<?xml version="1.0"?>
<psalm
        errorLevel="8"
        findUnusedCode="false"
        resolveFromConfigFile="true"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src"/>
        <!--
            "../../menatwork" only exists in the devstack, where the sibling package sits next to
            this one. A standalone checkout - CI, for instance - has no such directory, and psalm
            aborts while parsing its config when an ignore path cannot be resolved, so it never
            gets as far as writing the checkstyle report. allowMissingFiles keeps the entry
            meaningful in the devstack without breaking every other layout.
        -->
        <ignoreFiles allowMissingFiles="true">
            <directory name="vendor"/>
            <directory name="../../menatwork"/>
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <UndefinedClass>
            <errorLevel type="suppress">
                <referencedClass name="ContaoCommunityAlliance\DcGeneral\ContaoFrontend\CcaDcGeneralContaoFrontendBundle"/>
            </errorLevel>
        </UndefinedClass>
    </issueHandlers>
</psalm>
